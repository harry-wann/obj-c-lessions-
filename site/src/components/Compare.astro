---
// 四語言對照分頁。MDX 用法：<Compare><Fragment slot="swift">```swift ...```</Fragment> ...</Compare>
interface Props { title?: string }
const { title = '你已經會的' } = Astro.props;
const langs = [['swift', 'Swift'], ['kotlin', 'Kotlin'], ['java', 'Java'], ['ts', 'TypeScript']] as const;
const present = langs.filter(([k]) => Astro.slots.has(k));
---
<div class="callout compare">
  <div class="callout-title">🔁 {title}</div>
  <div class="tabs" role="tablist">{present.map(([k, label]) => <button type="button" role="tab" data-k={k} aria-selected="false">{label}</button>)}</div>
  {present.map(([k]) => <div class="panel" data-k={k} hidden><slot name={k} /></div>)}
  {Astro.slots.has('default') && <div class="mt-2 text-[0.9375rem]"><slot /></div>}
</div>
