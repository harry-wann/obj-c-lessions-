<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0"
    toolsVersion="14460.31" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none"
    useAutolayout="YES" useTraitCollections="YES" colorMatched="YES"
    initialViewController="nVc-Lg-001">
    <device id="retina4_7" orientation="portrait">
        <adaptation id="fullscreen"/>
    </device>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="14460.20"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Navigation Controller-->
        <scene sceneID="nSc-Lg-001">
            <objects>
                <navigationController id="nVc-Lg-001" sceneMemberID="viewController">
                    <navigationBar key="navigationBar" contentMode="scaleToFill"
                        insetsLayoutMarginsFromSafeArea="NO" id="nBr-Lg-001">
                        <rect key="frame" x="0.0" y="20" width="375" height="44"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="lVC-Lg-002" kind="relationship"
                            relationship="rootViewController" id="nRt-Lg-001"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fR1-Lg-001"
                    userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-680" y="80"/>
        </scene>
        <!--小帳本（老派版）-->
        <scene sceneID="lSc-Lg-002">
            <objects>
                <tableViewController id="lVC-Lg-002" customClass="LBLegacyListViewController"
                    sceneMemberID="viewController">
                    <tableView key="view" clipsSubviews="YES" contentMode="scaleToFill"
                        alwaysBounceVertical="YES" dataMode="prototypes" style="plain"
                        separatorStyle="default" rowHeight="44" sectionHeaderHeight="28"
                        sectionFooterHeight="28" id="tBv-Lg-002">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES"
                            heightSizable="YES"/>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom"
                            customColorSpace="genericGamma22GrayColorSpace"/>
                        <view key="tableHeaderView" contentMode="scaleToFill" id="hDr-Lg-002">
                            <rect key="frame" x="0.0" y="0.0" width="375" height="56"/>
                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"
                                flexibleMaxY="YES"/>
                            <subviews>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left"
                                    text="合計 NT$0" textAlignment="right"
                                    lineBreakMode="tailTruncation"
                                    baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO"
                                    id="tTl-Lg-002">
                                    <rect key="frame" x="16" y="16" width="343" height="24"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES"
                                        flexibleMaxY="YES"/>
                                    <fontDescription key="fontDescription" type="boldSystem"
                                        pointSize="17"/>
                                    <nil key="textColor"/>
                                    <nil key="highlightedColor"/>
                                </label>
                            </subviews>
                            <color key="backgroundColor" white="0.96" alpha="1" colorSpace="custom"
                                customColorSpace="genericGamma22GrayColorSpace"/>
                        </view>
                        <prototypes>
                            <tableViewCell clipsSubviews="YES" contentMode="scaleToFill"
                                selectionStyle="default" accessoryType="disclosureIndicator"
                                indentationWidth="10" reuseIdentifier="LBLegacyTransactionCell"
                                textLabel="cT1-Lg-002" detailTextLabel="cT2-Lg-002"
                                style="IBUITableViewCellStyleValue1" id="cEl-Lg-002">
                                <rect key="frame" x="0.0" y="84" width="375" height="44"/>
                                <autoresizingMask key="autoresizingMask"/>
                                <tableViewCellContentView key="contentView" opaque="NO"
                                    clipsSubviews="YES" multipleTouchEnabled="YES"
                                    contentMode="center" tableViewCell="cEl-Lg-002" id="cCv-Lg-002">
                                    <rect key="frame" x="0.0" y="0.0" width="341" height="43.5"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <subviews>
                                        <label opaque="NO" multipleTouchEnabled="YES"
                                            contentMode="left" text="備註" textAlignment="natural"
                                            lineBreakMode="tailTruncation"
                                            baselineAdjustment="alignBaselines"
                                            adjustsFontSizeToFit="NO" id="cT1-Lg-002">
                                            <rect key="frame" x="16" y="12" width="35"
                                                height="20.5"/>
                                            <autoresizingMask key="autoresizingMask"
                                                flexibleMaxX="YES" flexibleMaxY="YES"/>
                                            <fontDescription key="fontDescription" type="system"
                                                pointSize="17"/>
                                            <nil key="textColor"/>
                                            <nil key="highlightedColor"/>
                                        </label>
                                        <label opaque="NO" multipleTouchEnabled="YES"
                                            contentMode="left" text="NT$0" textAlignment="right"
                                            lineBreakMode="tailTruncation"
                                            baselineAdjustment="alignBaselines"
                                            adjustsFontSizeToFit="NO" id="cT2-Lg-002">
                                            <rect key="frame" x="290" y="12" width="43"
                                                height="20.5"/>
                                            <autoresizingMask key="autoresizingMask"
                                                flexibleMinX="YES" flexibleMaxY="YES"/>
                                            <fontDescription key="fontDescription" type="system"
                                                pointSize="17"/>
                                            <color key="textColor" white="0.5" alpha="1"
                                                colorSpace="custom"
                                                customColorSpace="genericGamma22GrayColorSpace"/>
                                            <nil key="highlightedColor"/>
                                        </label>
                                    </subviews>
                                </tableViewCellContentView>
                            </tableViewCell>
                        </prototypes>
                        <connections>
                            <outlet property="dataSource" destination="lVC-Lg-002" id="oDs-Lg-002"/>
                            <outlet property="delegate" destination="lVC-Lg-002" id="oDg-Lg-002"/>
                        </connections>
                    </tableView>
                    <navigationItem key="navigationItem" title="小帳本（老派版）" id="nIt-Lg-002">
                        <barButtonItem key="rightBarButtonItem" systemItem="add" id="aDd-Lg-002">
                            <connections>
                                <action selector="addTapped:" destination="lVC-Lg-002"
                                    id="aAc-Lg-002"/>
                            </connections>
                        </barButtonItem>
                    </navigationItem>
                    <connections>
                        <outlet property="summaryLabel" destination="tTl-Lg-002" id="oSm-Lg-002"/>
                        <segue destination="dVC-Lg-003" kind="show" identifier="showDetail"
                            id="sDt-Lg-002"/>
                    </connections>
                </tableViewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fR2-Lg-002"
                    userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="100" y="80"/>
        </scene>
        <!--明細-->
        <scene sceneID="dSc-Lg-003">
            <objects>
                <viewController id="dVC-Lg-003" customClass="LBLegacyDetailViewController"
                    sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="dVw-Lg-003">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES"
                            heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left"
                                text="備註" textAlignment="natural" lineBreakMode="tailTruncation"
                                numberOfLines="2" baselineAdjustment="alignBaselines"
                                adjustsFontSizeToFit="NO" id="dNt-Lg-003">
                                <rect key="frame" x="20" y="96" width="335" height="30"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES"
                                    flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="boldSystem"
                                    pointSize="22"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left"
                                text="金額（NT$）" textAlignment="natural"
                                lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines"
                                adjustsFontSizeToFit="NO" id="dCp-Lg-003">
                                <rect key="frame" x="20" y="142" width="335" height="20"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES"
                                    flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system"
                                    pointSize="15"/>
                                <color key="textColor" white="0.5" alpha="1" colorSpace="custom"
                                    customColorSpace="genericGamma22GrayColorSpace"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <textField opaque="NO" contentMode="scaleToFill"
                                contentHorizontalAlignment="left" contentVerticalAlignment="center"
                                borderStyle="roundedRect" placeholder="0" textAlignment="natural"
                                minimumFontSize="17" id="dAm-Lg-003">
                                <rect key="frame" x="20" y="168" width="250" height="34"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES"
                                    flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system"
                                    pointSize="17"/>
                                <textInputTraits key="textInputTraits" keyboardType="decimalPad"/>
                            </textField>
                            <button opaque="NO" contentMode="scaleToFill"
                                contentHorizontalAlignment="center"
                                contentVerticalAlignment="center" buttonType="roundedRect"
                                lineBreakMode="middleTruncation" id="dSv-Lg-003">
                                <rect key="frame" x="285" y="168" width="70" height="34"/>
                                <autoresizingMask key="autoresizingMask" flexibleMinX="YES"
                                    flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system"
                                    pointSize="17"/>
                                <state key="normal" title="儲存"/>
                                <connections>
                                    <action selector="saveTapped:" destination="dVC-Lg-003"
                                        eventType="touchUpInside" id="dSa-Lg-003"/>
                                </connections>
                            </button>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left"
                                text="匯率載入中…" textAlignment="natural" lineBreakMode="tailTruncation"
                                baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO"
                                id="dRt-Lg-003">
                                <rect key="frame" x="20" y="218" width="335" height="21"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES"
                                    flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system"
                                    pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom"
                            customColorSpace="genericGamma22GrayColorSpace"/>
                    </view>
                    <navigationItem key="navigationItem" title="明細" id="dNi-Lg-003"/>
                    <connections>
                        <outlet property="amountField" destination="dAm-Lg-003" id="oAm-Lg-003"/>
                        <outlet property="noteLabel" destination="dNt-Lg-003" id="oNt-Lg-003"/>
                        <outlet property="rateLabel" destination="dRt-Lg-003" id="oRt-Lg-003"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fR3-Lg-003"
                    userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="880" y="80"/>
        </scene>
    </scenes>
</document>
